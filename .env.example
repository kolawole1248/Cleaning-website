# --- Database ---
# LOCAL development: SQLite file (no setup needed — this is all you need
# on your own computer).
DATABASE_URL="file:./dev.db"

# HOSTED (Vercel): fill these and the site uses your Turso database instead
# of the local file. Get them with: turso db show za-cleaning  /  turso db tokens create
# TURSO_DATABASE_URL="libsql://za-cleaning-yourname.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."

# --- Admin login session secret ---
# Change this to a long random string before going live (same value in Vercel)
SESSION_SECRET="za-cleaning-change-this-to-a-long-random-string"

# --- Public site URL (used for sitemap/robots AND the links inside emails) ---
# Local: http://localhost:3000 — Vercel: your real domain, e.g. https://zacleans.co.uk
SITE_URL="http://localhost:3000"

# --- Email notifications (Gmail app password) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="zacleans26@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="ZA Cleaning Co Ltd <zacleans26@gmail.com>"
BUSINESS_EMAIL="zacleans26@gmail.com"

# --- Customer photo storage ---
# LOCAL: nothing needed here — photos go to public/uploads.
# HOSTED (Vercel): fill these and photos go to Cloudinary instead.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="123456789012345"
# CLOUDINARY_API_SECRET="your-api-secret"
# (a combined CLOUDINARY_URL=cloudinary://key:secret@cloud also works)

# --- Optional: card payments on quotes (Stripe secret key from
# https://dashboard.stripe.com/apikeys — without it, quotes are sent
# with bank transfer details and your Stripe payment link from Settings)
# STRIPE_SECRET_KEY="sk_live_..."
